{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenBench",
  "version": "0.1.0",
  "identifier": "org.openbench.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenBench",
        "width": 1366,
        "height": 768,
        "minWidth": 1000,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Education",
    "shortDescription": "Учебный стенд цифровой схемотехники",
    "longDescription": "Редактор логических схем с Word Generator, Logic Analyzer и локальным MCP-сервером.",
    "copyright": "MIT License"
  }
}
