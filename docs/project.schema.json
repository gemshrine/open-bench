{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "components": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "type": {
            "type": "string",
            "enum": [
              "INPUT",
              "OUTPUT",
              "CONST0",
              "CONST1",
              "BUFFER",
              "NOT",
              "AND",
              "NAND",
              "OR",
              "NOR",
              "XOR",
              "XNOR",
              "WORD_GENERATOR",
              "LOGIC_ANALYZER"
            ]
          },
          "x": {
            "type": "number",
            "minimum": -100000,
            "maximum": 100000
          },
          "y": {
            "type": "number",
            "minimum": -100000,
            "maximum": 100000
          },
          "label": {
            "type": "string",
            "maxLength": 64
          },
          "value": {
            "anyOf": [
              {
                "type": "number",
                "const": 0
              },
              {
                "type": "number",
                "const": 1
              }
            ]
          },
          "key": {
            "type": "string",
            "maxLength": 1
          },
          "inputs": {
            "type": "integer",
            "minimum": 2,
            "maximum": 8
          }
        },
        "required": [
          "id",
          "type",
          "x",
          "y"
        ],
        "additionalProperties": false
      }
    },
    "junctions": {
      "maxItems": 100000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "x": {
            "type": "number",
            "minimum": -100000,
            "maximum": 100000
          },
          "y": {
            "type": "number",
            "minimum": -100000,
            "maximum": 100000
          }
        },
        "required": [
          "id",
          "x",
          "y"
        ],
        "additionalProperties": false
      }
    },
    "wires": {
      "maxItems": 100000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "a": {
            "type": "string",
            "minLength": 1,
            "maxLength": 130
          },
          "b": {
            "type": "string",
            "minLength": 1,
            "maxLength": 130
          },
          "points": {
            "maxItems": 256,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number",
                  "minimum": -100000,
                  "maximum": 100000
                },
                "y": {
                  "type": "number",
                  "minimum": -100000,
                  "maximum": 100000
                }
              },
              "required": [
                "x",
                "y"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "a",
          "b"
        ],
        "additionalProperties": false
      }
    },
    "instruments": {
      "type": "object",
      "properties": {
        "wordGenerator": {
          "type": "object",
          "properties": {
            "words": {
              "maxItems": 1024,
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              }
            },
            "cycle": {
              "type": "boolean"
            },
            "stepsPerSecond": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 1000
            }
          },
          "required": [
            "words",
            "cycle",
            "stepsPerSecond"
          ],
          "additionalProperties": false
        },
        "logicAnalyzer": {
          "type": "object",
          "properties": {
            "channels": {
              "minItems": 16,
              "maxItems": 16,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "maxLength": 32
                  },
                  "visible": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "label",
                  "visible"
                ],
                "additionalProperties": false
              }
            },
            "maxHistory": {
              "type": "integer",
              "minimum": 16,
              "maximum": 1000000
            },
            "clocksPerDivision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            }
          },
          "required": [
            "channels",
            "maxHistory",
            "clocksPerDivision"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "wordGenerator",
        "logicAnalyzer"
      ],
      "additionalProperties": false
    },
    "viewport": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "minimum": -100000,
          "maximum": 100000
        },
        "y": {
          "type": "number",
          "minimum": -100000,
          "maximum": 100000
        },
        "zoom": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 10
        }
      },
      "required": [
        "x",
        "y",
        "zoom"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "title",
    "components",
    "junctions",
    "wires",
    "instruments"
  ],
  "additionalProperties": false
}
